# ========================================
# 证道 (ZhengDao) - 环境变量配置
# ========================================

# AI API Key (用于AI复盘分析)
# 支持的服务: GLM-4 (智谱AI) / MiniMax / DeepSeek / Gemini (Google)
# GLM-4: https://open.bigmodel.cn/ (推荐，国内访问快)
# DeepSeek: https://platform.deepseek.com/api_keys
# Gemini: https://makersuite.google.com/app/apikey (备用，当 DeepSeek 失败时使用)

# GLM-4 API Key (推荐)
GLM_API_KEY=your_glm_api_key_here

# MiniMax API Key (备用，当 GLM 达到限制时使用)
# 获取方式: https://api.minimax.chat/
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here

# DeepSeek API Key (备选)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Gemini API Key (备用，当 DeepSeek 失败时使用)
# 获取方式: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# BNB Chain 智能合约配置
# ========================================

# 部署者私钥（不要包含 0x 前缀）
# 警告: 仅用于测试，不要在主网使用真实私钥
# 获取方式: 从MetaMask等钱包导出
PRIVATE_KEY=your_private_key_here

# BNB Chain Testnet RPC URL
BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# BNB Chain Mainnet RPC URL (生产环境)
BNB_MAINNET_RPC_URL=https://bsc-dataseed.binance.org/

# BscScan API Key (用于合约验证)
# 获取方式: https://testnet.bscscan.com/myapikey
BSCSCAN_API_KEY=your_bscscan_api_key_here

# 智能合约地址（部署后更新）
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ZHENGDAO_SBT_ADDRESS=0x0000000000000000000000000000000000000000

# SBT 元数据基础 URI（部署后更新为实际域名）
NEXT_PUBLIC_SBT_BASE_URI=https://your-domain.com/api/sbt-metadata/

# ========================================
# 可选配置
# ========================================

# WalletConnect Project ID (如果使用WalletConnect)
# 获取方式: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ========================================
# 开发说明
# ========================================

# 1. 复制此文件为 .env.local
#    cp .env.local.example .env.local

# 2. 填写你的API密钥
#    DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxx
#    PRIVATE_KEY=你的私钥(测试用)
#    BSCSCAN_API_KEY=你的BscScan API密钥

# 3. (可选) 获取测试币
#    访问: https://testnet.bnbchain.org/faucet-smart
#    输入你的钱包地址获取测试BNB

# 4. 重启开发服务器
#    npm run dev

# ========================================
# 注意事项
# ========================================

# - 不要将 .env.local 提交到Git
# - .env.local 已在 .gitignore 中排除
# - 如果不配置任何 AI API Key，系统会使用Mock数据
# - Mock数据可以正常演示，但无法体验真正的AI分析
# - 推荐配置顺序: GLM-4 > MiniMax > DeepSeek > Gemini
# - 系统会自动在服务失败时降级到备用服务
