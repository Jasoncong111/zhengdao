# ========================================
# 证道 (ZhengDao) - 环境变量配置
# ========================================

# DeepSeek API Key (用于AI复盘分析)
# 获取方式: https://platform.deepseek.com/api_keys
# 成本: ¥1/1M tokens (约100次复盘 = ¥0.025)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ========================================
# 可选配置
# ========================================

# WalletConnect Project ID (如果使用WalletConnect)
# 获取方式: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ========================================
# 开发说明
# ========================================

# 1. 复制此文件为 .env.local
#    cp .env.local.example .env.local

# 2. 填写你的API密钥
#    DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxx

# 3. 重启开发服务器
#    npm run dev

# ========================================
# 注意事项
# ========================================

# - 不要将 .env.local 提交到Git
# - .env.local 已在 .gitignore 中排除
# - 如果不配置 DEEPSEEK_API_KEY，系统会使用Mock数据
# - Mock数据可以正常演示，但无法体验真正的AI分析
