      "expected_result": "error",
      "error_code": "InvalidLevel",
      "description": "测试无效等级7"
    },
    {
      "scenario": "Metadata Too Long",
      "level": 1,
      "days": 7,
      "metadata_uri": "https://example.com/" + "x".repeat(300),
      "expected_result": "error",
      "error_code": "MetadataUriTooLong",
      "description": "测试超长元数据URI"
    },
    {
      "scenario": "Unauthorized Update",
      "level": 1,
      "days": 7,
      "action": "update_metadata",
      "authority": "unauthorized_user",
      "expected_result": "error",
      "error_code": "Unauthorized",
      "description": "测试未授权的元数据更新"
    }
